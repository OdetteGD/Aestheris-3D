<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AestherisCore</AssemblyName>
    <RootNamespace>Aestheris.Scripting</RootNamespace>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AestherisComponent.cs" />
    <Compile Include="AetherisNative.cs" />
    <Compile Include="PlayerController.cs" />
    <Compile Include="ScriptRuntime.cs" />
  </ItemGroup>
</Project>
